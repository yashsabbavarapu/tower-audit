# Which grader to use: anthropic | gemini | demo.
# Unset: Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else demo mode.
# An explicit choice always wins; if its key is missing, Tower runs demo mode and says so in the UI.
TOWER_GRADER=

# Anthropic grader.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5-5).
TOWER_MODEL=

# Gemini grader (free tier). Get a key at https://aistudio.google.com -> "Get API key".
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.8-flash).
TOWER_GEMINI_MODEL=
